SUPABASE_JWT_SECRET=your_supabase_jwt_secret
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional local bypass for development only.
# AUTH_BYPASS_USER_ID=dev-user-1
# AUTH_BYPASS_EMAIL=dev@example.com

# Technology-risk /v1 demo auth (header-based demo principal — not production IdP).
# TRISK_API_TOKEN=change-me
# TRISK_DEFAULT_TENANT=default
# TRISK_DEFAULT_ACTOR=api-client

# P0 agent enrollment hashing pepper. Prefer this over TRISK_API_TOKEN for secret hashes.
# Use an independent random secret in any non-local environment.
# TRISK_AGENT_TOKEN_PEPPER=replace-with-a-long-random-secret

# Classification outbox: post-commit queue enqueue (default on).
# Set false to leave durable pending rows for drills; recover via admin sweep force=true.
# TRISK_OUTBOX_DISPATCH_ENABLED=true

# Continuous outbox sweeper daemon (default off — avoids test races / local surprise enqueue).
# Enable in soak/deployed single-process environments; not a cluster leader election.
# TRISK_OUTBOX_SWEEPER_ENABLED=false
# TRISK_OUTBOX_SWEEPER_INTERVAL_SECONDS=30

# Platform API (Bearer token for /platform/* when set)
# PLATFORM_API_KEY=change-me-in-production
# PLATFORM_DATA_DIR=./platform_data
# PLATFORM_SAFE_MODE=1
